# Copy to .env.test and fill in. NEVER commit .env.test (it is gitignored).
# Format: KEY=value, no quotes, no trailing spaces.

FHE_SITE_URL=https://
FHE_ADMIN_EMAIL=admin@fhequestrian.com

# PREFERRED: set a password on the admin account via the site's /forgot-password
# flow, then put it here. This does NOT remove Google sign-in — it adds a second
# way in, which is what lets a browser log in without touching Google's OAuth.
FHE_ADMIN_PASSWORD=

# ALTERNATIVE: instead of a password, sign in yourself once and save a Playwright
# storageState JSON, then point at it here. Leave blank if using the password.
FHE_STORAGE_STATE=
