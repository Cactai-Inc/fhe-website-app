{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/notifications-nudge",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/expire-holds",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/calendar-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/delivery-sweep",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/mint-monthly-allotments",
      "schedule": "20 8 * * *"
    }
  ],
  "redirects": [
    { "source": "/ride", "destination": "/lessons", "permanent": true },
    { "source": "/shop", "destination": "/lessons", "permanent": true },
    { "source": "/membership", "destination": "/lessons", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "preview": true,
      "main": true
    }
  }
}
